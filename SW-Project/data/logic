{"color":-16729254,"id":"10","nextBlock":-1,"opCode":"addSourceDirectly","parameters":["final SharedPreferences prefsTheme \u003d getSharedPreferences(\"RumiAppPrefs\", MODE_PRIVATE);\nfinal String spMode \u003d prefsTheme.getString(\"reader_color_mode\", prefsTheme.getBoolean(\"dark_mode\", false) ? \"dark\" : \"light\");\nfinal String spFont \u003d prefsTheme.getString(\"reader_font\", \"iransans\");\nfinal boolean spDark \u003d \"dark\".equals(spMode);\nfinal boolean spPaper \u003d \"paper\".equals(spMode);\n\n// ۴. تعیین پالت رنگی اصلی اسپلش بر اساس حالت رنگ ذخیره‌شده (هماهنگ با کل برنامه)\nfinal int colorBackground \u003d Color.parseColor(spDark ? \"#0B1F1F\" : (spPaper ? \"#3B2A1A\" : \"#086972\"));\nfinal int colorTitleText  \u003d Color.parseColor(spDark ? \"#E6E1E5\" : (spPaper ? \"#F4ECD8\" : \"#F7F3E8\"));\nfinal int colorSubText    \u003d Color.parseColor(spDark ? \"#B8C4C4\" : (spPaper ? \"#D8C9A4\" : \"#DED8C8\"));\nfinal int colorProgress   \u003d Color.parseColor(\"#D4A017\");\nfinal int colorProgTrack  \u003d Color.parseColor(spDark ? \"#33FFFFFF\" : \"#20FFFFFF\");\n\n// ۱. تنظیم رنگ استاتوس‌بار و نوار ناوبری متناسب با تم فعلی\nif (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.LOLLIPOP) {\n    getWindow().setStatusBarColor(colorBackground);\n    getWindow().setNavigationBarColor(colorBackground);\n    if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.M) {\n        View splashDecor \u003d getWindow().getDecorView();\n        int splashFlags \u003d splashDecor.getSystemUiVisibility();\n        // اسپلش همیشه پس‌زمینه تیره یا رنگی دارد، پس آیکون‌های روشن سیستم مناسب‌ترند\n        splashFlags \u0026\u003d ~View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.O) splashFlags \u0026\u003d ~View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;\n        splashDecor.setSystemUiVisibility(splashFlags);\n    }\n}\n\n// ۲. مقداردهی ایمن AdMob\ntry {\n    com.google.android.gms.ads.MobileAds.initialize(MainActivity.this, new com.google.android.gms.ads.initialization.OnInitializationCompleteListener() {\n        @Override\n        public void onInitializationComplete(com.google.android.gms.ads.initialization.InitializationStatus initializationStatus) {}\n    });\n} catch (Exception e) {}\n\n// ۳. دریافت تنظیمات زبان از فایل سراسری AppSettings\nSharedPreferences prefsApp \u003d getSharedPreferences(\"AppSettings\", MODE_PRIVATE);\nString currentLang \u003d prefsApp.getString(\"app_lang\", \"fa\");\nif (currentLang.equals(\"auto\")) {\n    currentLang \u003d Locale.getDefault().getLanguage();\n}\n\n// ۵. پیدا کردن المان‌ها و اعمال ظاهر و انیمیشن‌ها\ntry {\n    int idMain \u003d getResources().getIdentifier(\"layoutSplashMain\", \"id\", getPackageName());\n    int idLogo \u003d getResources().getIdentifier(\"imgSplashLogo\", \"id\", getPackageName());\n    int idName \u003d getResources().getIdentifier(\"txtAppName\", \"id\", getPackageName());\n    int idSub \u003d getResources().getIdentifier(\"txtSubTitle\", \"id\", getPackageName());\n    int idContainer \u003d getResources().getIdentifier(\"layoutLogoContainer\", \"id\", getPackageName());\n    int idProgContainer \u003d getResources().getIdentifier(\"linearProgressContainer\", \"id\", getPackageName());\n    int idLoadingTxt \u003d getResources().getIdentifier(\"txtLoading\", \"id\", getPackageName());\n    final int idProgress \u003d getResources().getIdentifier(\"progressLoading\", \"id\", getPackageName());\n\n    if (idMain !\u003d 0) findViewById(idMain).setBackgroundColor(colorBackground);\n\n    // ---------- تعیین قلم فعال (هماهنگ با کل برنامه: شبنم / وزیرمتن / ایران‌سنس) ----------\n    Typeface splashTf \u003d Typeface.DEFAULT;\n    try {\n        if (\"shabnam\".equals(spFont)) splashTf \u003d Typeface.createFromAsset(getAssets(), \"fonts/shabnam.ttf\");\n        else if (\"vazirmatn\".equals(spFont)) splashTf \u003d Typeface.createFromAsset(getAssets(), \"fonts/vazirmatn.ttf\");\n        else splashTf \u003d Typeface.createFromAsset(getAssets(), \"fonts/iraniansans.ttf\");\n    } catch (Exception fontEx) {}\n    final Typeface fSplashTf \u003d splashTf;\n\n    // انیمیشن لوگو\n    if (idLogo !\u003d 0) {\n        View imgLogo \u003d findViewById(idLogo);\n        ((ImageView) imgLogo).clearColorFilter();\n        \n        AnimationSet logoAnim \u003d new AnimationSet(true);\n        ScaleAnimation scale \u003d new ScaleAnimation(\n            0.6f, 1.0f, 0.6f, 1.0f,\n            Animation.RELATIVE_TO_SELF, 0.5f,\n            Animation.RELATIVE_TO_SELF, 0.5f\n        );\n        AlphaAnimation alpha \u003d new AlphaAnimation(0.0f, 1.0f);\n        \n        logoAnim.addAnimation(scale);\n        logoAnim.addAnimation(alpha);\n        logoAnim.setDuration(900);\n        logoAnim.setInterpolator(new DecelerateInterpolator());\n        imgLogo.startAnimation(logoAnim);\n    }\n    \n    if (idName !\u003d 0) {\n        TextView txtAppName \u003d findViewById(idName);\n        txtAppName.setTextColor(colorTitleText);\n        txtAppName.setTypeface(fSplashTf, Typeface.BOLD);\n        if (currentLang.equals(\"fa\")) txtAppName.setText(\"کاخ اسرار\");\n        else txtAppName.setText(\"Kakh Asrar\");\n    }\n    \n    if (idSub !\u003d 0) {\n        TextView txtSubTitle \u003d findViewById(idSub);\n        txtSubTitle.setTextColor(colorSubText);\n        txtSubTitle.setTypeface(fSplashTf);\n        if (currentLang.equals(\"fa\")) txtSubTitle.setText(\"داستان‌های مثنوی معنوی مولوی\");\n        else txtSubTitle.setText(\"Masnavi Tales \u0026 Wisdom\");\n    }\n    \n    if (idLoadingTxt !\u003d 0) {\n        TextView txtLoading \u003d findViewById(idLoadingTxt);\n        txtLoading.setTextColor(colorSubText);\n        txtLoading.setTypeface(fSplashTf);\n        if (currentLang.equals(\"fa\")) txtLoading.setText(\"در حال بارگذاری...\");\n        else txtLoading.setText(\"Loading...\");\n\n        AlphaAnimation pulse \u003d new AlphaAnimation(0.3f, 1.0f);\n        pulse.setDuration(800);\n        pulse.setRepeatMode(Animation.REVERSE);\n        pulse.setRepeatCount(Animation.INFINITE);\n        txtLoading.startAnimation(pulse);\n    }\n    \n    if (idContainer !\u003d 0) {\n        View layoutLogoContainer \u003d findViewById(idContainer);\n        if (currentLang.equals(\"fa\")) {\n            layoutLogoContainer.setLayoutDirection(View.LAYOUT_DIRECTION_RTL);\n        } else {\n            layoutLogoContainer.setLayoutDirection(View.LAYOUT_DIRECTION_LTR);\n        }\n    }\n\n    // ---------- نوار بارگذاری به سبک متریال (گوشه‌گرد، مسیر شیشه‌ای، سایه ظریف) ----------\n    if (idProgContainer !\u003d 0 \u0026\u0026 idProgress !\u003d 0) {\n        final View progContainer \u003d findViewById(idProgContainer);\n        final View progressLinear \u003d findViewById(idProgress);\n\n        GradientDrawable bgDrawable \u003d new GradientDrawable();\n        bgDrawable.setColor(colorProgTrack);\n        bgDrawable.setCornerRadius(100f);\n        progContainer.setBackground(bgDrawable);\n\n        GradientDrawable barDrawable \u003d new GradientDrawable();\n        barDrawable.setColor(colorProgress);\n        barDrawable.setCornerRadius(100f);\n        progressLinear.setBackground(barDrawable);\n\n        if (Build.VERSION.SDK_INT \u003e\u003d Build.VERSION_CODES.LOLLIPOP) {\n            progressLinear.setElevation(4f * getResources().getDisplayMetrics().density);\n        }\n\n        progContainer.post(new Runnable() {\n            @Override\n            public void run() {\n                float parentWidth \u003d progContainer.getWidth();\n                float barWidth \u003d progressLinear.getWidth();\n                float startX \u003d parentWidth - barWidth;\n                float endX \u003d -barWidth;\n\n                TranslateAnimation animation \u003d new TranslateAnimation(\n                    startX, endX, 0f, 0f\n                );\n                animation.setDuration(1200);\n                animation.setRepeatCount(Animation.INFINITE);\n                animation.setRepeatMode(Animation.RESTART);\n                animation.setInterpolator(new AccelerateDecelerateInterpolator());\n                progressLinear.startAnimation(animation);\n            }\n        });\n    }\n\n} catch (Exception e) {}\n\n// ۶. بارگذاری دیتای اولیه‌ی JSON\n\n\n// ۷. زمان‌بندی هوشمند با تضمین حداقل ۳.۵ ثانیه اسپلش و انتقال به HomeActivity\nfinal long startTime \u003d System.currentTimeMillis();\nfinal long MIN_SPLASH_TIME \u003d 3500;\n\nfinal Runnable goToHomeRunnable \u003d new Runnable() {\n    private boolean isExecuted \u003d false;\n    @Override\n    public void run() {\n        if (isExecuted) return;\n        isExecuted \u003d true;\n\n        long elapsedTime \u003d System.currentTimeMillis() - startTime;\n        long remainingTime \u003d MIN_SPLASH_TIME - elapsedTime;\n\n        if (remainingTime \u003e 0) {\n            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {\n                @Override\n                public void run() {\n                    navigateToHome();\n                }\n            }, remainingTime);\n        } else {\n            navigateToHome();\n        }\n    }\n\n    private void navigateToHome() {\n        try {\n            Intent intent \u003d new Intent();\n            intent.setClass(getApplicationContext(), HomeActivity.class);\n            startActivity(intent);\n            overridePendingTransition(android.R.anim.fade_in, android.R.anim.fade_out);\n            finish();\n        } catch (Exception e) {}\n    }\n};\n\n// ۸. اجرای درخواست UMP / GDPR (Google)\ntry {\n    com.google.android.ump.ConsentRequestParameters params \u003d new com.google.android.ump.ConsentRequestParameters.Builder().build();\n    final com.google.android.ump.ConsentInformation consentInformation \u003d com.google.android.ump.UserMessagingPlatform.getConsentInformation(MainActivity.this);\n\n    consentInformation.requestConsentInfoUpdate(\n        MainActivity.this,\n        params,\n        new com.google.android.ump.ConsentInformation.OnConsentInfoUpdateSuccessListener() {\n            @Override\n            public void onConsentInfoUpdateSuccess() {\n                if (consentInformation.isConsentFormAvailable()) {\n                    com.google.android.ump.UserMessagingPlatform.loadConsentForm(\n                        MainActivity.this,\n                        new com.google.android.ump.UserMessagingPlatform.OnConsentFormLoadSuccessListener() {\n                            @Override\n                            public void onConsentFormLoadSuccess(com.google.android.ump.ConsentForm consentForm) {\n                                if (consentInformation.getConsentStatus() \u003d\u003d com.google.android.ump.ConsentInformation.ConsentStatus.REQUIRED) {\n                                    consentForm.show(\n                                        MainActivity.this,\n                                        new com.google.android.ump.ConsentForm.OnConsentFormDismissedListener() {\n                                            @Override\n                                            public void onConsentFormDismissed(com.google.android.ump.FormError formError) {\n                                                goToHomeRunnable.run();\n                                            }\n                                        }\n                                    );\n                                } else {\n                                    goToHomeRunnable.run();\n                                }\n                            }\n                        },\n                        new com.google.android.ump.UserMessagingPlatform.OnConsentFormLoadFailureListener() {\n                            @Override\n                            public void onConsentFormLoadFailure(com.google.android.ump.FormError formError) {\n                                goToHomeRunnable.run();\n                            }\n                        }\n