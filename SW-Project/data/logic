{"color":-16729254,"id":"10","nextBlock":-1,"opCode":"addSourceDirectly","parameters":["} // بستن متد onCreate اسکتچ‌ور\n\n// \u003d\u003d\u003d\u003d\u003d ۱. تعریف متغیرهای اکتیویتی \u003d\u003d\u003d\u003d\u003d\nprivate String currentStoryId \u003d \"1\";\nprivate String currentTitle \u003d \"\";\nprivate String currentDaftar \u003d \"\";\nprivate String currentCode \u003d \"\";\n\nprivate ArrayList\u003cJSONObject\u003e allStories \u003d new ArrayList\u003c\u003e();\nprivate int currentStoryIndex \u003d -1;\n\nprivate SharedPreferences prefs;\n\nprivate View mainLayout;\nprivate TextView tvStoryTitle;\nprivate TextView tvStoryDaftar;\nprivate TextView tvReadingTime;\nprivate android.webkit.WebView tvStoryContent;\nprivate ImageView btnBookmark;\nprivate ImageView btnBack;\nprivate LinearLayout btnTextSettings;\nprivate LinearLayout btnShare;\nprivate LinearLayout btnNextStory;\nprivate ScrollView scrollView;\n\nprivate View adBannerPlaceholder;\nprivate ImageView imageview16;\n\n// \u003d\u003d\u003d\u003d\u003d ۲. متدها و منطق برنامه \u003d\u003d\u003d\u003d\u003d\nprivate void loadStoriesFromJson() {\n    allStories.clear();\n    try {\n        InputStream is \u003d getAssets().open(\"rumiPersian.json\");\n        int size \u003d is.available();\n        byte[] buffer \u003d new byte[size];\n        is.read(buffer);\n        is.close();\n        String jsonString \u003d new String(buffer, \"UTF-8\");\n\n        JSONObject jsonObject \u003d new JSONObject(jsonString);\n        String[] daftarKeys \u003d new String[]{\"دفتر اول\", \"دفتر دوم\", \"دفتر سوم\", \"دفتر چهارم\", \"دفتر پنجم\", \"دفتر ششم\"};\n        for (String key : daftarKeys) {\n            if (jsonObject.has(key)) {\n                JSONArray daftarArray \u003d jsonObject.optJSONArray(key);\n                if (daftarArray !\u003d null) {\n                    for (int i \u003d 0; i \u003c daftarArray.length(); i++) {\n                        allStories.add(daftarArray.getJSONObject(i));\n                    }\n                }\n            }\n        }\n    } catch (Exception e) {\n        e.printStackTrace();\n    }\n}\n\nprivate void displayStoryById(String storyId) {\n    for (int i \u003d 0; i \u003c allStories.size(); i++) {\n        JSONObject story \u003d allStories.get(i);\n        if (story.optString(\"id\", \"\").equals(storyId)) {\n            currentStoryIndex \u003d i;\n            currentTitle \u003d story.optString(\"title\", \"\");\n            currentDaftar \u003d story.optString(\"daftar\", \"\");\n            currentCode \u003d story.optString(\"code\", \"\");\n            break;\n        }\n    }\n\n    if (currentStoryIndex !\u003d -1) {\n        tvStoryTitle.setText(currentTitle);\n        tvStoryDaftar.setText(\"از \" + currentDaftar);\n\n        // اجرای Justify تخصصی و صددرصدی\n        safelyJustifyText(tvStoryContent, currentCode);\n\n        int wordCount \u003d currentCode.split(\"\\\\s+\").length;\n        int readingTimeMinutes \u003d Math.max(1, wordCount / 100);\n        tvReadingTime.setText(\"زمان مطالعه: \" + readingTimeMinutes + \" دقیقه\");\n\n        prefs.edit()\n            .putString(\"last_story_id\", currentStoryId)\n            .putString(\"last_story_title\", currentTitle)\n            .putString(\"last_story_daftar\", currentDaftar)\n            .putInt(\"last_story_progress\", 100)\n            .apply();\n\n        updateBookmarkIcon();\n        scrollView.scrollTo(0, 0);\n    }\n}\n\n// \u003d\u003d\u003d\u003d\u003d خواندن تنظیمات ذخیره‌شده‌ی صفحه تنظیمات \u003d\u003d\u003d\u003d\u003d\nprivate String getReaderMode() {\n    return prefs.getString(\"reader_color_mode\",\n            prefs.getBoolean(\"dark_mode\", false) ? \"dark\" : \"light\");\n}\n\nprivate String getReaderFontFile() {\n    String k \u003d prefs.getString(\"reader_font\", \"iransans\");\n    if (\"shabnam\".equals(k)) return \"fonts/shabnam.ttf\";\n    if (\"vazirmatn\".equals(k)) return \"fonts/vazirmatn.ttf\";\n    return \"fonts/iraniansans.ttf\";\n}\n\nprivate android.graphics.Typeface getReaderTypeface() {\n    try {\n        return android.graphics.Typeface.createFromAsset(getAssets(), getReaderFontFile());\n    } catch (Exception e) {\n        return android.graphics.Typeface.DEFAULT;\n    }\n}\n\n// رنگ آیکون نشان‌کردن مطابق حالت رنگ و وضعیت نشان‌شده\nprivate void applyBookmarkTint() {\n    if (btnBookmark \u003d\u003d null) return;\n    String mode \u003d getReaderMode();\n    boolean dark \u003d \"dark\".equals(mode);\n    boolean paper \u003d \"paper\".equals(mode);\n\n    int cIdle \u003d Color.parseColor(dark ? \"#CAC4D0\" : (paper ? \"#7A6A52\" : \"#74777F\"));\n    int cActive \u003d Color.parseColor(dark ? \"#A8C7FA\" : (paper ? \"#7A4A1F\" : \"#1F3A8A\"));\n\n    Set\u003cString\u003e saved \u003d prefs.getStringSet(\"bookmarked_ids\", new HashSet\u003cString\u003e());\n    boolean on \u003d saved.contains(currentStoryId);\n    btnBookmark.setColorFilter(on ? cActive : cIdle, android.graphics.PorterDuff.Mode.SRC_IN);\n}\n\n// متد تراز دوطرفه (Justify) متون فارسی با WebView و CSS\nprivate void safelyJustifyText(final android.webkit.WebView webView, final String content) {\n    if (webView \u003d\u003d null || content \u003d\u003d null) return;\n\n    try {\n        int textSize \u003d Math.max(12, Math.min(28, prefs.getInt(\"text_size\", 16)));\n        float lineSpacing \u003d Math.max(1.0f, Math.min(2.5f, prefs.getFloat(\"line_spacing\", 1.9f)));\n\n        String mode \u003d getReaderMode();\n        boolean dark \u003d \"dark\".equals(mode);\n        boolean paper \u003d \"paper\".equals(mode);\n\n        String bg \u003d dark ? \"#121212\" : (paper ? \"#F4ECD8\" : \"#FFFDF9\");\n        String fg \u003d dark ? \"#E6E1E5\" : (paper ? \"#3B3022\" : \"#2D3133\");\n\n        String safe \u003d content\n                .replace(\"\u0026\", \"\u0026amp;\")\n                .replace(\"\u003c\", \"\u0026lt;\")\n                .replace(\"\u003e\", \"\u0026gt;\")\n                .replac