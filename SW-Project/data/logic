lete(String id, UnityAds.UnityAdsShowCompletionState s) { afterAd(); }\n            @Override public void onUnityAdsShowFailure(String id, UnityAds.UnityAdsShowError e, String m) { afterAd(); }\n        });\n    } else {\n        goTo(target);\n    }\n}\n\nprivate void afterAd() {\n    runOnUiThread(new Runnable() {\n        @Override public void run() {\n            adShowing \u003d false;\n            goTo(pendingTarget);\n            loadAd();\n        }\n    });\n}\n\nprivate void goTo(Class\u003c?\u003e target) {\n    if (target \u003d\u003d null) return;\n    startActivity(new Intent(ReaderActivity.this, target));\n    Animatoo.animateFade(ReaderActivity.this);\n}\n\npublic void _adDummy() {"],"spec":"add source directly %s.inputOnly","subStack1":-1,"subStack2":-1,"type":" ","typeName":""}

